# Development Email Configuration
# Copy these to your .env file for development

# For Gmail SMTP (Production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ptamsar.co.id"
MAIL_FROM_NAME="PT Amsar Prima Mandiri"

# For Mailpit (Local Development)
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="noreply@ptamsar.co.id"
# MAIL_FROM_NAME="PT Amsar Prima Mandiri"

# For Log Driver (Development - No Email)
# MAIL_MAILER=log
# MAIL_HOST=null
